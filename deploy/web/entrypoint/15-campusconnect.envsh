#!/bin/sh
# Sourced by the nginx image's entrypoint before the templates are rendered.
# Hashes of the SPA's inline scripts (computed at build time) for the Content-Security-Policy.
export CSP_SCRIPT_HASHES="$(cat /usr/share/nginx/html/.csp-hashes 2>/dev/null)"
export SERVER_NAME="${SERVER_NAME:-_}"
export TLS_CERT="${TLS_CERT:-/etc/nginx/certs/fullchain.pem}"
export TLS_KEY="${TLS_KEY:-/etc/nginx/certs/privkey.pem}"
