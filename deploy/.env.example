# CampusConnect production settings. Copy to deploy/.env and fill in. Never commit .env.
# Generate secrets with: openssl rand -base64 48

# ---------------------------------------------------------------- Required secrets
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=

# ---------------------------------------------------------------- Database
# MongoDB Atlas (recommended), e.g. mongodb+srv://user:pass@cluster0.xxxx.mongodb.net/campusconnect?retryWrites=true&w=majority
# Leave empty and start with `--profile local` to use the bundled single-node replica set.
MONGODB_URI=
MONGO_MAX_POOL_SIZE=100

# ---------------------------------------------------------------- Public addresses
# The public origin of the site (CORS, links in e-mails). Same origin as the API behind Nginx.
CLIENT_URL=https://campus.example.edu
SERVER_NAME=campus.example.edu
# Refresh cookie: Strict when the SPA and API share one origin (this compose setup).
COOKIE_SECURE=true
COOKIE_SAME_SITE=Strict

# ---------------------------------------------------------------- University
UNIVERSITY_DOMAIN=ddu.ac.in
UNIVERSITY_NAME=Dharmsinh Desai University
UNIVERSITY_TZ_OFFSET=+05:30

# First university admin (created once if no admin exists).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=University Admin

# ---------------------------------------------------------------- E-mail (Brevo API, or SMTP)
MAIL_FROM=CampusConnect <no-reply@campus.example.edu>
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_RATE_PER_MINUTE=30
# Addresses never e-mailed (regular expression for the whole address), e.g. demo accounts on a demo site.
MAIL_SUPPRESS_PATTERN=

# ---------------------------------------------------------------- Media (Cloudinary; empty = local uploads volume)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=campusconnect

# ---------------------------------------------------------------- Web Push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@campus.example.edu

# ---------------------------------------------------------------- Capacity
API_REPLICAS=3
API_CPUS=1.5
API_MEMORY=1536M
# Sign-ins one replica checks at once (bcrypt: about 4 per second each). 0 = one less than the replica's CPUs, at
# most 4 (1 with API_CPUS=1.5, 2 with API_CPUS=3). For sign-in rushes raise API_CPUS or add replicas rather than
# this: hashing on every CPU starves the rest of the API (2 threads at API_CPUS=1.5 made all requests 4x slower).
PASSWORD_HASH_THREADS=0
REDIS_MAXMEMORY=512mb
# Per signed-in user (or IP) per 15 minutes; sign-in attempts per IP per 15 minutes.
API_RATE_LIMIT=2000
AUTH_RATE_LIMIT=100
UPLOAD_RATE_LIMIT=120

# ---------------------------------------------------------------- Optional
RABBITMQ_USER=campusconnect
GRAFANA_PASSWORD=
TAG=latest
