# Copy to .env (or .env.local) for local settings. Every value is optional; the defaults below are what the
# app uses when a variable is missing.

# ---------------------------------------------------------------- Development server (vite / vite preview)
# The Spring Boot API that the dev server proxies /api, /uploads and /ws (WebSocket) to.
VITE_API_PROXY=http://localhost:8080
VITE_PORT=3000

# ---------------------------------------------------------------- Built into the app
# REST API base path. Keep "/api" when the SPA and the API share an origin (Vite proxy in development,
# Nginx in the Docker deployment). A full URL ("https://api.example.edu/api") also works if the API allows
# this origin (CORS) and sends the refresh cookie for it.
VITE_API_URL=/api

# Live chat (STOMP over WebSocket). Leave empty to use the page's own origin: ws(s)://<host>/ws.
# Accepts a path ("/ws") or a full URL ("wss://chat.example.edu/ws"; http(s):// is turned into ws(s)://).
VITE_WS_URL=

# Must match the backend's university settings.
VITE_UNIVERSITY_DOMAIN=ddu.ac.in
VITE_UNIVERSITY_TIMEZONE=Asia/Kolkata
VITE_UNIVERSITY_TZ_OFFSET=+05:30
